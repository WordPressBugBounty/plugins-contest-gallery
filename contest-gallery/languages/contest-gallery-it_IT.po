#: check-language-general.php
msgid "Send new PIN in {seconds}s"
msgstr "Invia il nuovo PIN tra {seconds}s"

#: check-language-general.php
msgid "The account confirmation could not be prepared."
msgstr "Non è stato possibile preparare la conferma dell'account."

#: check-language-general.php
msgid "No registered user was found for this email address."
msgstr "Nessun utente registrato trovato per questo indirizzo email."

#: check-language-general.php
msgid "The user account could not be found."
msgstr "Impossibile trovare l'account utente."

#: check-language-general.php
msgid "PIN data was not found. Please contact the administrator."
msgstr "I dati PIN non sono stati trovati. Si prega di contattare l'amministratore."

#: check-language-general.php
msgid "The user account could not be created. Please contact the administrator."
msgstr "Impossibile creare l'account utente. Si prega di contattare l'amministratore."

#: check-language-general.php
msgid "The user could not be signed in after the PIN check. Please contact the administrator."
msgstr "Non è stato possibile accedere all'utente dopo la verifica del PIN. Si prega di contattare l'amministratore."

#: check-language-general.php
msgid "The PIN could not be confirmed. Please contact the administrator."
msgstr "Impossibile confermare il PIN. Si prega di contattare l'amministratore."

#: check-language-paid-actions.php
msgid "Checkout could not be started."
msgstr "Impossibile avviare il check-out."

#: check-language-paid-actions.php
msgid "Processing…"
msgstr "Elaborazione..."

#: check-language-paid-actions.php
msgid "Processing payment"
msgstr "Elaborazione pagamento"

#: check-language-paid-actions.php
msgid "You may be redirected to complete the payment. You will return automatically."
msgstr "Potresti essere reindirizzato per completare il pagamento. Tornerai automaticamente."

#: check-language-paid-actions.php
msgid "This browser could not access the saved checkout data. Return to the gallery and contact the site owner before making another payment."
msgstr "Questo browser non è riuscito ad accedere ai dati di check-out salvati. Torna alla gallery e contatta il proprietario del sito prima di effettuare un altro pagamento."

#: check-language-paid-actions.php
msgid "The saved checkout data could not be opened. You can safely try finalizing this same payment again."
msgstr "Impossibile aprire i dati di check-out salvati. Puoi tranquillamente provare a finalizzare di nuovo lo stesso pagamento."

#: check-language-paid-actions.php
msgid "Another browser tab is currently using the saved checkout data. Close the other tab and try finalizing this same payment again."
msgstr "Un'altra scheda del browser sta attualmente utilizzando i dati di check-out salvati. Chiudi l'altra scheda e riprova a finalizzare lo stesso pagamento."

#: check-language-paid-actions.php
msgid "The saved checkout data could not be read. You can safely try finalizing this same payment again."
msgstr "Impossibile leggere i dati di check-out salvati. Puoi tranquillamente provare a finalizzare di nuovo lo stesso pagamento."

#: check-language-paid-actions.php
msgid "Your test payment was approved. We are creating the gallery order and adding your credits now. You will return to the gallery automatically."
msgstr "Il tuo pagamento di prova è stato approvato. Stiamo creando l'ordine della galleria e aggiungendo i tuoi crediti ora. Tornerai automaticamente alla galleria."

#: check-language-paid-actions.php
msgid "Your payment was approved. We are creating the gallery order and adding your credits now. You will return to the gallery automatically."
msgstr "Il tuo pagamento è stato approvato. Stiamo creando l'ordine della galleria e aggiungendo i tuoi crediti ora. Tornerai automaticamente alla galleria."

#: check-language-paid-actions.php
msgid "The saved checkout data was not found in this browser. Return to the gallery and contact the site owner before making another payment."
msgstr "I dati di check-out salvati non sono stati trovati in questo browser. Torna alla gallery e contatta il proprietario del sito prima di effettuare un altro pagamento."

#: check-language-paid-actions.php
msgid "Payment processing could not be started. You can safely try finalizing this same payment again."
msgstr "Impossibile avviare l'elaborazione del pagamento. Puoi tranquillamente provare a finalizzare di nuovo lo stesso pagamento."

